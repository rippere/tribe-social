# RunPod credentials
RUNPOD_API_KEY=your_runpod_api_key_here

# GPU configuration — change if you want a different GPU tier
RUNPOD_GPU_TYPE_ID=NVIDIA A100 80GB PCIe
RUNPOD_CONTAINER_DISK_GB=50

# Docker image — must have TRIBE v2 pre-installed
# Use your custom image if you have one from Phase 0
RUNPOD_IMAGE=runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

# SSH key — must be registered in RunPod account settings
RUNPOD_SSH_KEY_PATH=~/.ssh/id_rsa
RUNPOD_SSH_USER=root

# HuggingFace token (for TRIBE v2 model download on pod)
HF_TOKEN=your_hf_token_here
